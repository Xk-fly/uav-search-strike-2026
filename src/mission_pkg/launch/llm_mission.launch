<launch>
    <!-- 任务参数配置 -->
    <param name="goal_topic" value="/move_base_simple/goal" type="str"/>
    <param name="planner_cmd_topic" value="/planning/pos_cmd" type="str"/>

    <!-- 相机内参 (640x480, 90° FOV) -->
    <param name="fx" value="320.0" type="double"/>
    <param name="fy" value="320.0" type="double"/>
    <param name="cx" value="320.0" type="double"/>
    <param name="cy" value="240.0" type="double"/>

    <!-- 相机外参：相机到机体坐标系的变换 (ENU 机体系) -->
    <rosparam param="cam2body_R">[0,0,1, -1,0,0, 0,-1,0]</rosparam>
    <rosparam param="cam2body_T">[0.1, 0.04, 0.05]</rosparam>

    <!-- 目标检测话题 -->
    <param name="detect_result_topic" value="/objects" type="str"/>

    <!-- 到达判定容差 -->
    <param name="tolerance" value="0.15" type="double"/>
    <param name="yaw_tolerance" value="0.15" type="double"/>

    <!-- 安全边界参数 -->
    <param name="safety/enabled" value="true" type="bool"/>
    <param name="safety/x_min" value="-1.0" type="double"/>
    <param name="safety/x_max" value="6.0" type="double"/>
    <param name="safety/y_min" value="-3.0" type="double"/>
    <param name="safety/y_max" value="3.0" type="double"/>
    <param name="safety/z_min" value="-0.1" type="double"/>
    <param name="safety/z_max" value="2.5" type="double"/>

    <!-- ============================================ -->
    <!-- 任务航点坐标配置 (ENU: x=东/右, y=北/前, z=上) -->
    <!-- 比赛前根据实际场地调整                          -->
    <!-- ============================================ -->

    <!-- 起飞 -->
    <param name="takeoff/goal" value="0.0;0.0;1.0" type="str"/>

    <!-- 穿越方框 -->
    <param name="cross_frame/observe_pos"        value="0.0;-1.0;1.0"  type="str"/>    <!-- 观察位置 -->
    <param name="cross_frame/observe_delay_ms"    value="2000"          type="double"/> <!-- 到达后等待时间(ms) -->
    <param name="cross_frame/object_width"        value="1.3"          type="double"/> <!-- 方框物理宽度(m) -->
    <param name="cross_frame/object_height"       value="1.3"          type="double"/> <!-- 方框物理高度(m) -->
    <param name="cross_frame/occlusion_direction" value="right"         type="str"/>    <!-- 遮挡方向 -->
    <param name="cross_frame/expected_pos"        value="3.25;-0.4;1.0" type="str"/>    <!-- 方框预期位置 -->
    <param name="cross_frame/z_tolerance"         value="0.5"           type="double"/> <!-- z方向容差 -->
    <param name="cross_frame/filter_window_size"  value="20"            type="double"/> <!-- 滤波窗口 -->
    <param name="cross_frame/offset_z"            value="1.0"           type="double"/> <!-- 规划z偏移 -->

    <!-- ArUco 往返/反穿框前后精准移动（仅 PrecisionMove 使用，不修改普通 GoTo） -->
    <param name="precision_move/max_speed"       value="0.35" type="double"/> <!-- 参考轨迹最大三维速度 m/s -->
    <param name="precision_move/max_accel"       value="0.25" type="double"/> <!-- 参考轨迹加减速度 m/s^2 -->
    <param name="precision_move/max_lead"        value="0.25" type="double"/> <!-- 位置参考点超前机体的最大沿线距离 m -->
    <param name="precision_move/tolerance"       value="0.12" type="double"/> <!-- 最终三维位置误差 m -->
    <param name="precision_move/speed_tolerance" value="0.10" type="double"/> <!-- 稳定时实际速度上限 m/s -->
    <param name="precision_move/settle_time"     value="0.70" type="double"/> <!-- 达标持续时间 s -->
    <param name="precision_move/timeout"         value="60.0" type="double"/> <!-- 单段执行最大时长 s -->
    <param name="precision_move/odom_timeout"    value="1.00" type="double"/> <!-- 里程计失联阈值 s -->
    <param name="precision_move/abort_speed"     value="0.70" type="double"/> <!-- 实际速度异常熔断 m/s -->
    <param name="precision_move/yaw_rate"        value="0.50" type="double"/> <!-- 偏航设定角速度限幅 rad/s -->

    <!-- ArUco 检测 -->
    <param name="aruco/hover_pos" value="4.5;0.5;1.2" type="str"/>     <!-- 二维码上方悬停位置 -->

    <!-- 返程动态朝向与单次反穿框额外前进1m -->
    <param name="return_cross_frame/yaw_rate" value="0.35" type="double"/>
    <param name="return_cross_frame/exit_distance" value="1.5" type="double"/>
    <param name="return_cross_frame/approach_extra_distance" value="0.5" type="double"/>
    <!-- 返回穿越方框 -->

    <!-- 降落 -->
    <param name="land/return_safe_pos" value="0.0;0.0;1.0" type="str"/>
    <param name="land/stable_speed_mps" value="0.16" type="double"/>
    <param name="land/stable_time_sec" value="0.90" type="double"/>
    <param name="land/stable_timeout_sec" value="9.0" type="double"/>
    <param name="land/return_pos" value="0.0;0.0;0.5" type="str"/>     <!-- 降落前返回位置 -->
    <param name="land/return_yaw" value="0.0" type="double"/>         <!-- 降落前航向(rad) -->

    <!-- ============================================ -->
    <!-- 气球颜色→区域映射（比赛前根据实际配置修改）    -->
    <!-- ============================================ -->
    <param name="balloon_color_red"    value="A" type="str"/>
    <param name="balloon_color_blue"   value="C" type="str"/>
    <param name="balloon_color_purple" value="B" type="str"/>

    <!-- ============================================ -->
    <!-- 穿回框后掉头朝向                               -->
    <!-- ============================================ -->

    <!-- ============================================ -->
    <!-- 气球打击区域配置（比赛前调整）                   -->
    <!-- approach_pos: PlanningControl 规划飞到的接近点  -->
    <!-- goal: 到达后转向的位置                          -->
    <!-- yaw:  到达位置时的机头朝向 (rad)                -->
    <!-- ============================================ -->
    <!-- A区 (红色气球) -->
    <param name="balloon_zone_A/approach_pos" value="5.3;1.0;0.90" type="str"/>
    <param name="balloon_zone_A/goal"         value="5.3;1.0;0.90" type="str"/>
    <param name="balloon_zone_A/yaw"          value="1.5708"        type="double"/>
    <!-- A区动态跑道：仅到位后首见红球才锁定航向，丢失时悬停等待重新出现 -->
    <param name="balloon_zone_A/approach_area_threshold" value="0.05" type="double"/>
    <param name="balloon_zone_A/approach_center_limit_px" value="65.0" type="double"/>
    <param name="balloon_zone_A/sprint_center_limit_px" value="40.0" type="double"/>
    <param name="balloon_zone_A/align_frames_required" value="3" type="int"/>
    <param name="balloon_zone_A/sprint_vertical_limit_px" value="130.0" type="double"/>
    <param name="balloon_zone_A/initial_search_max_yaw_rad" value="1.20" type="double"/>
    <param name="balloon_zone_A/lock_confirmation_frames" value="3" type="int"/>
    <param name="balloon_zone_A/sprint_confirmation_frames" value="5" type="int"/>
    <param name="balloon_zone_A/min_tracking_after_lock_sec" value="1.5" type="double"/>
    <param name="balloon_zone_A/min_world_z" value="0.72" type="double"/>
    <param name="balloon_zone_A/search_yaw_rate" value="0.12" type="double"/>
    <param name="balloon_zone_A/data_timeout" value="0.40" type="double"/>
    <param name="balloon_zone_A/strike_timeout_ms" value="90000" type="int"/>
    <!-- B区 (紫色气球) -->
    <param name="balloon_zone_B/approach_pos" value="5.3;-2.0;0.7" type="str"/>
    <param name="balloon_zone_B/goal"         value="5.3;-2.0;0.7" type="str"/>
    <param name="balloon_zone_B/yaw"          value="3.14159"       type="double"/>
    <!-- C区 (蓝色气球) -->
    <param name="balloon_zone_C/approach_pos" value="5.3;1.0;0.7"  type="str"/>
    <param name="balloon_zone_C/goal"         value="5.3;1.0;0.7"  type="str"/>
    <param name="balloon_zone_C/yaw"          value="-1.5708"       type="double"/>

    <!-- ============================================ -->
    <!-- VisualServo 视觉伺服参数（与手调 XML 一致）     -->
    <!-- ============================================ -->
    <param name="visual_servo/k_p_yaw_rate"            value="0.003" type="double"/>
    <param name="visual_servo/k_d_yaw_rate"            value="0.001" type="double"/>
    <param name="visual_servo/k_p_vz"                  value="0.01"  type="double"/>
    <param name="visual_servo/k_d_vz"                  value="0.006" type="double"/>
    <param name="visual_servo/approach_area_threshold"  value="0.08"  type="double"/>
    <param name="visual_servo/forward_velocity"         value="0.4"   type="double"/>
    <param name="visual_servo/sprint_velocity"          value="0.9"   type="double"/>
    <param name="visual_servo/sprint_time"              value="0.6"   type="double"/>
    <param name="visual_servo/max_sprint_yaw_rate"     value="0.08"  type="double"/>
    <param name="visual_servo/approach_center_limit_px" value="48.0" type="double"/>
    <param name="visual_servo/sprint_center_limit_px" value="24.0" type="double"/>
    <param name="visual_servo/brake_time"              value="0.5"   type="double"/>
    <param name="visual_servo/min_world_z"             value="0.90" type="double"/>
    <param name="visual_servo/max_descent_from_entry"  value="0.15" type="double"/>
    <param name="visual_servo/max_vertical_speed"      value="0.10" type="double"/>

    <!-- 运行任务节点（LLM 模式） -->
    <node pkg="mission_pkg" type="bt_ros" name="llm_mission_node" output="screen">
        <param name="mode" value="llm" type="str"/>
    </node>

    <!-- 日志录制（可选，默认关闭） -->
    <arg name="enable_logging" default="true"/>
    <arg name="log_dir" default="$(env HOME)/uav_demo_bags"/>
    
    <node if="$(arg enable_logging)" 
          pkg="rosbag" 
          type="record" 
          name="mission_logger"
          args="/mavros/local_position/odom 
                /mavros/state 
                /mavros/setpoint_raw/local 
                /objects
                /objects_down
                /rflysim/uav1/local/odom
                /balloon_attack/target_visible
                /balloon_attack/hit_candidate
                /balloon_attack/postcheck_result
                /aruco/detected_id
                /rosout
                /planning/pos_cmd 
                /move_base_simple/goal 
                /mission_command 
                /mission_result 
                -o $(arg log_dir)/llm_mission_"/>
</launch>
